{
  "name": "spread-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension showing the all-in cost of a Coinbase Simple trade before Confirm.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "check:realdata": "node scripts/check-realdata.mjs",
    "capture:fixtures": "node --experimental-strip-types scripts/capture-fixtures.ts",
    "test": "npm run check:realdata && npm run typecheck && vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.4.1",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
